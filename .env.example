# Code-signing credentials for local builds.
# Copy this file to `.env` (gitignored) and fill in real values.
# Leave a group empty to build that platform unsigned.
#
# CI does not read this file — see GitHub repo secrets instead.

# ───────────────────────────────────────────────────────────────
# macOS — Developer ID signing + Apple notarisation
# ───────────────────────────────────────────────────────────────

# Path to the exported Developer ID .p12 file
# (export from Keychain Access → Certificates → Right-click → Export…)
CSC_LINK=./secrets/developer-id.p12

# Password set when exporting the .p12
CSC_KEY_PASSWORD=

# Apple ID + app-specific password (appleid.apple.com → Sign-In and Security)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# 10-character Team ID (top right in developer.apple.com)
APPLE_TEAM_ID=

# ───────────────────────────────────────────────────────────────
# Windows — Azure Trusted Signing
# (only needed for local Windows builds; CI uses GH secrets)
# ───────────────────────────────────────────────────────────────

# Service Principal credentials for the Trusted Signing API.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Account / profile / endpoint default to the von Poll setup
# (account "digital", profile "remotion-desktop", region West Europe).
# Only set these to override.
# AZURE_CODE_SIGNING_ACCOUNT_NAME=digital
# AZURE_CERT_PROFILE_NAME=remotion-desktop
# AZURE_CODE_SIGNING_ENDPOINT=https://weu.codesigning.azure.net/
